<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限，不加连不上网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 定位权限，签到需要 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CampusStudyRoomBookingSystem">

        <!-- 登录页为启动入口 -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".RoomListActivity"
            android:exported="false" />

        <activity
            android:name=".RoomDetailActivity"
            android:exported="false" />

        <activity
            android:name=".SeatActivity"
            android:exported="false" />

        <activity
            android:name=".MyReservationActivity"
            android:exported="false" />

        <activity
            android:name=".CreateReservationActivity"
            android:exported="false" />

        <activity
            android:name=".CreateReviewActivity"
            android:exported="false" />

        <activity
            android:name=".ReviewListActivity"
            android:exported="false" />

        <activity android:name=".AdminRoomActivity"/>
        <activity android:name=".AdminSeatActivity" />
        <activity android:name=".MessageActivity" />
        <activity android:name=".AdminMessageActivity" />
        <activity android:name=".QuickReserveActivity" />
        <activity android:name=".StatisticsActivity" />
        <activity android:name=".ChatActivity" />

    </application>

</manifest>
