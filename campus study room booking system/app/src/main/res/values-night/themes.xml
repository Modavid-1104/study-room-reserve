<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CampusStudyRoomBookingSystem" parent="Theme.Material3.Dark.NoActionBar">
        <!-- 主色（中性灰） -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/white</item>


        <!-- 背景与表面 -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>

        <!-- 文字 -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>

        <!-- 状态栏跟随背景 -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <!-- 所有按钮统一使用自定义圆角样式 -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>

    </style>

    <style name="Theme.CampusStudyRoomBookingSystem" parent="Base.Theme.CampusStudyRoomBookingSystem" />
</resources>
